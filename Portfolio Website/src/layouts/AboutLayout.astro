---
// src/layouts/AboutLayout.astro
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title}>
  <div class="minimal-about">
    <slot />
  </div>

  <style>
    .about {
      max-width: 720px;
      margin: 0 auto;
      padding: 2rem;
    }

    .about h1 {
      font-size: 2rem;
      margin-bottom: 2rem;
    }

    .about p {
      margin-bottom: 1rem;
      line-height: 1.7;
    }

    @media (max-width: 768px) {
      .minimal-about {
        padding: 1rem;
      }
    }
  </style>
</BaseLayout>